@{
    ViewData["Title"] = "KVS World";
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>KVS</title>
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }

        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background: linear-gradient(135deg, #1a1a2e, #16213e, #0f3460);
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            color: white;
        }

        .container {
            text-align: center;
            padding: 60px 40px;
            background: rgba(255,255,255,0.05);
            border-radius: 20px;
            border: 1px solid rgba(255,255,255,0.1);
            backdrop-filter: blur(10px);
            max-width: 700px;
            width: 90%;
        }

        .badge {
            display: inline-block;
            background: #28b463;
            color: white;
            padding: 6px 18px;
            border-radius: 20px;
            font-size: 13px;
            font-weight: 600;
            letter-spacing: 1px;
            margin-bottom: 24px;
            text-transform: uppercase;
        }

        h1 {
            font-size: 52px;
            font-weight: 700;
            margin-bottom: 10px;
            background: linear-gradient(90deg, #00d2ff, #3a7bd5);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }

        h2 {
            font-size: 22px;
            font-weight: 400;
            color: rgba(255,255,255,0.7);
            margin-bottom: 40px;
        }

        .info-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 16px;
            margin-top: 30px;
        }

        .info-card {
            background: rgba(255,255,255,0.08);
            border-radius: 12px;
            padding: 16px 20px;
            text-align: left;
            border: 1px solid rgba(255,255,255,0.08);
        }

        .info-card .label {
            font-size: 11px;
            color: rgba(255,255,255,0.4);
            text-transform: uppercase;
            letter-spacing: 1px;
            margin-bottom: 6px;
        }

        .info-card .value {
            font-size: 15px;
            color: #00d2ff;
            font-weight: 600;
        }

        .footer {
            margin-top: 40px;
            font-size: 13px;
            color: rgba(255,255,255,0.3);
        }

        .dot {
            display: inline-block;
            width: 10px;
            height: 10px;
            background: #28b463;
            border-radius: 50%;
            margin-right: 6px;
            animation: pulse 1.5s infinite;
        }

        @@keyframes pulse {
            0%   { box-shadow: 0 0 0 0 rgba(40,180,99,0.6); }
            70%  { box-shadow: 0 0 0 10px rgba(40,180,99,0); }
            100% { box-shadow: 0 0 0 0 rgba(40,180,99,0); }
        }
    </style>
</head>
<body>
    <div class="container">
        <div class="badge">✅ Live</div>
        <h1>KVS World</h1>
        <h2>Deployed via GitHub Actions + AWS OIDC</h2>

        <div style="margin: 20px 0; font-size: 15px; color: rgba(255,255,255,0.6);">
            <span class="dot"></span> Application is running successfully
        </div>

        <div class="info-grid">
            <div class="info-card">
                <div class="label">Platform</div>
                <div class="value">Windows Server 2025</div>
            </div>
            <div class="info-card">
                <div class="label">Web Server</div>
                <div class="value">IIS + ASP.NET Core 8</div>
            </div>
            <div class="info-card">
                <div class="label">CI/CD</div>
                <div class="value">GitHub Actions OIDC</div>
            </div>
            <div class="info-card">
                <div class="label">Deployed At</div>
                <div class="value">@DateTime.Now.ToString("dd MMM yyyy HH:mm")</div>
            </div>
            <div class="info-card">
                <div class="label">Branch</div>
                <div class="value">main</div>
            </div>
            <div class="info-card">
                <div class="label">Environment</div>
                <div class="value">Production</div>
            </div>
        </div>

        <div class="footer">
            KVS Enterprise · Powered by .NET 8 · @DateTime.Now.Year
        </div>
    </div>
</body>
</html>